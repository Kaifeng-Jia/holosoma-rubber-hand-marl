<?xml version="1.0" ?>
<robot name="squaretable_demo3_training">
  <material name="squaretable_demo3_material">
    <color rgba="0.7 0.8 0.9 0.7"/>
  </material>
  <link name="squaretable_demo3_link">
    <!--
      Isolated Demo 3 training asset. Geometry matches objects_largetable.urdf.
      COM and inertia model the tabletop and four legs as five uniformly dense
      boxes scaled to a total mass of 20 kg. Runtime material is fixed by the
      environment to static/dynamic friction 0.5/0.5 and restitution 0.
    -->
    <inertial>
      <mass value="20.0"/>
      <origin rpy="0 0 0" xyz="0 -0.012413473401914 0"/>
      <inertia
        ixx="0.821972006993735"
        ixy="0"
        ixz="0"
        iyy="1.206183371508506"
        iyz="0"
        izz="0.821972006993735"
      />
    </inertial>

    <visual name="squaretable_demo3_tabletop">
      <origin rpy="0 0 0" xyz="0 0.036275 0"/>
      <geometry>
        <box size="0.5219528 0.04745 0.5219528"/>
      </geometry>
      <material name="squaretable_demo3_material"/>
    </visual>
    <collision name="squaretable_demo3_tabletop">
      <origin rpy="0 0 0" xyz="0 0.036275 0"/>
      <geometry>
        <box size="0.5219528 0.04745 0.5219528"/>
      </geometry>
    </collision>

    <visual name="squaretable_demo3_leg_neg_x_neg_z">
      <origin rpy="0 0 0" xyz="-0.23525 -0.17835 -0.23525"/>
      <geometry>
        <box size="0.05 0.3793 0.05"/>
      </geometry>
      <material name="squaretable_demo3_material"/>
    </visual>
    <collision name="squaretable_demo3_leg_neg_x_neg_z">
      <origin rpy="0 0 0" xyz="-0.23525 -0.17835 -0.23525"/>
      <geometry>
        <box size="0.05 0.3793 0.05"/>
      </geometry>
    </collision>

    <visual name="squaretable_demo3_leg_neg_x_pos_z">
      <origin rpy="0 0 0" xyz="-0.23525 -0.17835 0.23525"/>
      <geometry>
        <box size="0.05 0.3793 0.05"/>
      </geometry>
      <material name="squaretable_demo3_material"/>
    </visual>
    <collision name="squaretable_demo3_leg_neg_x_pos_z">
      <origin rpy="0 0 0" xyz="-0.23525 -0.17835 0.23525"/>
      <geometry>
        <box size="0.05 0.3793 0.05"/>
      </geometry>
    </collision>

    <visual name="squaretable_demo3_leg_pos_x_neg_z">
      <origin rpy="0 0 0" xyz="0.23525 -0.17835 -0.23525"/>
      <geometry>
        <box size="0.05 0.3793 0.05"/>
      </geometry>
      <material name="squaretable_demo3_material"/>
    </visual>
    <collision name="squaretable_demo3_leg_pos_x_neg_z">
      <origin rpy="0 0 0" xyz="0.23525 -0.17835 -0.23525"/>
      <geometry>
        <box size="0.05 0.3793 0.05"/>
      </geometry>
    </collision>

    <visual name="squaretable_demo3_leg_pos_x_pos_z">
      <origin rpy="0 0 0" xyz="0.23525 -0.17835 0.23525"/>
      <geometry>
        <box size="0.05 0.3793 0.05"/>
      </geometry>
      <material name="squaretable_demo3_material"/>
    </visual>
    <collision name="squaretable_demo3_leg_pos_x_pos_z">
      <origin rpy="0 0 0" xyz="0.23525 -0.17835 0.23525"/>
      <geometry>
        <box size="0.05 0.3793 0.05"/>
      </geometry>
    </collision>
  </link>
</robot>
